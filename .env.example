SNIPEIT_URL=https://snipeit.example.com
SNIPEIT_TOKEN=your-api-token-here
SNIPEIT_VERIFY_SSL=true

# Cloudflare Access service token (leave blank if not behind CF Access)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

APP_LANG=en
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional: absolute path to a company logo (PNG/JPG).
# Defaults to app/static/logo_placeholder.png if not set.
LOGO_PATH=

# Optional: footer text printed at the bottom of every generated document (PDF and DOCX).
# Leave blank to omit the footer.
DOC_FOOTER_TEXT=

# Optional: internal RFID printer service URL. When set, a "Print Tag" button appears per asset.
# The backend proxies POST {"tag": "<asset_tag>"} to this URL. Leave blank to disable.
RFID_PRINTER_URL=
